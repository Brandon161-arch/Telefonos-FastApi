# ====================== ElectroPhone - Configuración ======================
# Copia este archivo como `.env` y ajusta los valores según tu entorno.
# El archivo `.env` NO se sube a git.

# --- Aplicación ---
PROJECT_NAME=ElectroPhone Store
PROJECT_VERSION=1.0.0

# --- Seguridad JWT ---
# IMPORTANTE: cámbialo en producción
SECRET_KEY=super-secret-key-change-in-production-telefonos-fastapi-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Base de datos ---
# SQLite (por defecto):
DATABASE_URL=sqlite:///./telefonos.db
# PostgreSQL (ejemplo):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/electrophone

# --- Admin por defecto ---
FIRST_ADMIN_EMAIL=admin@electrophone.com
FIRST_ADMIN_PASSWORD=admin123456