# ====================== ElectroPhone - Configuración ======================
# Copia este archivo como `.env` y ajusta los valores según tu entorno.
# El archivo `.env` NO se sube a git.

# --- Aplicación ---
PROJECT_NAME=ElectroPhone Store
PROJECT_VERSION=1.0.0

# --- Seguridad JWT ---
# IMPORTANTE: cámbialo en producción
SECRET_KEY=super-secret-key-change-in-production-telefonos-fastapi-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Base de datos ---
# SQLite (por defecto):
DATABASE_URL=sqlite:///./telefonos.db
# PostgreSQL (ejemplo):
# DATABASE_URL=postgresql://usuario:password@localhost:5432/electrophone

# --- Admin por defecto ---
FIRST_ADMIN_EMAIL=admin@electrophone.com
FIRST_ADMIN_PASSWORD=admin123456

# --- URL pública de la app (para enlaces de verificación) ---
APP_BASE_URL=http://127.0.0.1:8000

# --- Email / SMTP (verificación por correo) ---
# Deja SMTP_HOST vacío para "enviar" por consola en desarrollo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@electrophone.com
SMTP_FROM_NAME=ElectroPhone Store
VERIFICATION_TOKEN_EXPIRE_HOURS=24