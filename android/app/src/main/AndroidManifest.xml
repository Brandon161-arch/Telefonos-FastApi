<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Necesario aunque sea "sin internet": el WebView se conecta a
         http://127.0.0.1:8000, que usa el stack de red de Android. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- PyApplication arranca el interprete de Python en el primer arranque
         del proceso (antes de que se cree la Activity). -->
    <application
        android:name="com.chaquo.python.android.PyApplication"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
